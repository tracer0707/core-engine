include "Base.fbs";

namespace Core.Serialization;

union ComponentData {
    Camera,
    MeshRenderer,
    Behavior
}

table Component {
    data:ComponentData;
}

table Camera {
	fov:float;
    near:float;
    far:float;
}

table MeshRenderer {
	mesh:Uuid;
    materials:[Uuid];
}

table Behavior {
    script:Uuid;
}